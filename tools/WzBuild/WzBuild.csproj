<Project Sdk="Microsoft.NET.Sdk">

  <!-- Small, dependency-free build orchestrator (the s&box SboxBuild analog).
       Invoked via `dotnet run` from build.cmd; never referenced by the engine
       build or the editor solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wzbuild</AssemblyName>
    <RootNamespace>WzBuild</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
