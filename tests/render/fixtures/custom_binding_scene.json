      },
      "visible": true
    },
    {
      "id": "camera_01",
      "parent": "root",
      "transform": {
        "translation": [0, 2, -8],
        "rotation_quat": [0, 0, 0, 1],
        "scale": [1, 1, 1]
      },
      "visible": true,
      "camera": {
        "fov_y": 1.0471999645233154,
        "near": 0.10000000149011612,
        "far": 1000,
        "aspect": 1.7777777910232544
      }
    },
    {
      "id": "bound",
      "parent": "root",
      "name": "bound",
      "transform": {
        "translation": [0, 0, 0],
        "rotation_quat": [0, 0, 0, 1],
        "scale": [200, 200, 200]
