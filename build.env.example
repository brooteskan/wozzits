# wozzits build configuration.
#
# Copy this file to `build.env` (git-ignored) and edit as needed. The orchestrator
# (build.cmd / tools/WzBuild) reads it. Precedence for every value:
#   command-line flag  >  real environment variable  >  build.env  >  built-in default
#
# so you can also override per-invocation (e.g. `build.cmd build --config Release`)
# or per-shell (a real WOZZITS_APP_INSTALL_DIR environment variable).

# Where the runnable app is assembled: the three engine binaries
# (wozzits_abi.dll, wozzits_editor_host.exe, wozzits_app_v1.exe) plus the
# published editor. Use forward slashes — they work for both CMake and dotnet.
WOZZITS_APP_INSTALL_DIR=D:/wozzits-app

# Engine + editor build configuration: Debug or Release.
WOZZITS_BUILD_CONFIG=Debug

# Editor publish mode:
#   framework-dependent  needs the .NET 10 Desktop Runtime on the target machine
#   self-contained       bundles the runtime (win-x64), larger but standalone
WOZZITS_EDITOR_PUBLISH=framework-dependent
