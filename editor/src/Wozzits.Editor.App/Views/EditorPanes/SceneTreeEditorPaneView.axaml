<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Wozzits.Editor.ViewModels.EditorPanes"
             x:Class="Wozzits.Editor.App.Views.EditorPanes.SceneTreeEditorPaneView"
             x:DataType="panes:SceneTreeEditorPaneViewModel">
    <Grid Classes="EditorPaneRoot">
        <Border Classes="PaneSurface">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock Text="{Binding EmptyState}"
                           Classes="PaneEmptyState"
                           IsVisible="{Binding HasNoScene}"/>

                <TreeView Grid.Row="1"
                          ItemsSource="{Binding Nodes}"
                          IsVisible="{Binding HasScene}"
                          SelectionChanged="SceneTreeSelectionChanged"
                          KeyDown="TreeKeyDown"
                          DragDrop.AllowDrop="True"
                          Classes="SceneTreeView">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="panes:SceneTreeNodeViewModel"
                                          ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        PointerPressed="NodePointerPressed">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add Child"
                                                  Click="AddChildClicked"/>
                                        <MenuItem Header="Delete"
                                                  Click="DeleteClicked"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding KindLabel}"
                                           Classes="SceneTreeNodeKind"/>
                                <TextBlock Text="{Binding DisplayText}"
                                           Classes="SceneTreeNodeName"/>
                                <!-- Runtime-grafted "Subtree from asset" node
                                     (issue #213): read-only, not authored. -->
                                <TextBlock Text="instanced"
                                           Opacity="0.6"
                                           FontStyle="Italic"
                                           IsVisible="{Binding IsInstanced}"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
