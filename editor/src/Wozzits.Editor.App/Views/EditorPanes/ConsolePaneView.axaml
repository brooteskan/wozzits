<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Wozzits.Editor.ViewModels.EditorPanes"
             x:Class="Wozzits.Editor.App.Views.EditorPanes.ConsolePaneView"
             x:DataType="panes:ConsolePaneViewModel">
    <Grid Classes="EditorPaneRoot">
        <Border Classes="ConsoleSurface">
            <ScrollViewer x:Name="LogScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AllowAutoHide="False">
                <SelectableTextBlock Text="{Binding LogText, Mode=OneWay}"
                                     Classes="ConsoleLogText"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
