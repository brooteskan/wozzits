<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Wozzits.Editor.ViewModels.EditorPanes"
             xmlns:model="using:Wozzits.Editor.Statecharts"
             x:Class="Wozzits.Editor.App.Views.EditorPanes.InspectorPaneView"
             x:DataType="panes:InspectorPaneViewModel">
    <UserControl.Resources>
        <!-- Keep enum-param dropdowns flat: the Fluent ComboBox otherwise turns
             solid cream/white on hover/press. Hold every state at the panel
             inset so the field does not change when hovered. -->
        <SolidColorBrush x:Key="ComboBoxBackground"
                         Color="{DynamicResource WozzitsPanelInsetColor}"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"
                         Color="{DynamicResource WozzitsPanelInsetColor}"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed"
                         Color="{DynamicResource WozzitsPanelInsetColor}"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"
                         Color="{DynamicResource WozzitsPanelInsetColor}"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"
                         Color="{DynamicResource WozzitsPanelInsetColor}"/>
        <SolidColorBrush x:Key="ComboBoxForeground"
                         Color="{DynamicResource WozzitsTextColor}"/>
        <SolidColorBrush x:Key="ComboBoxForegroundDisabled"
                         Color="{DynamicResource WozzitsMutedTextColor}"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush"
                         Color="{DynamicResource WozzitsPanelBorderColor}"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver"
                         Color="{DynamicResource WozzitsPanelBorderColor}"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"
                         Color="{DynamicResource WozzitsPanelBorderColor}"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled"
                         Color="{DynamicResource WozzitsPanelBorderColor}"/>
    </UserControl.Resources>
    <Grid Classes="EditorPaneRoot">
        <Border Classes="InspectorPaneSurface">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock Text="{Binding EmptyState}"
                           Classes="PaneEmptyState"
                           IsVisible="{Binding HasNoSelection}"/>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasSubGraphSelection}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Header}"
                                   Classes="InspectorHeader"/>
                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Sub-graph"
                                           Classes="InspectorSectionTitle"/>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Name"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SubGraphName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Nodes"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SubGraphMemberCount}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasSceneNodeSelection}">
                    <!-- Scene-node edits act on the live viewport runtime, so the
                         whole edit surface is disabled when it is down; fields stay
                         readable but non-interactive (mirrors the scene tree). -->
                    <StackPanel Spacing="12"
                                IsEnabled="{Binding CanEditNode}">
                        <TextBlock Text="{Binding Header}"
                                   Classes="InspectorHeader"/>
                        <TextBlock Text="{Binding LastEditError}"
                                   Classes="InspectorError"
                                   IsVisible="{Binding HasLastEditError}"/>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Scene Node"
                                           Classes="InspectorSectionTitle"/>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Node"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NodeId}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Name"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Parent"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ParentId}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <CheckBox Content="Node visible"
                                          IsChecked="{Binding NodeVisible}"
                                          Classes="InspectorCheck"/>

                                <!-- Draw-order layer (render_order). Selecting a
                                     layer sets it live; within a layer, order is
                                     the tree / drag reorder. -->
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Render layer"
                                               Classes="InspectorPropertyName"/>
                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding RenderLayers}"
                                              SelectedItem="{Binding SelectedRenderLayer}"
                                              DisplayMemberBinding="{Binding Label}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Renderable source"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RenderableSource}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasTransform}">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Transform"
                                           Classes="InspectorSectionTitle"/>

                                <Grid ColumnDefinitions="Auto,*,*,*"
                                      ColumnSpacing="6"
                                      Classes="InspectorVectorRow">
                                    <TextBlock Text="Translation"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding TranslationX, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding TranslationY, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding TranslationZ, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,*,*"
                                      ColumnSpacing="6"
                                      Classes="InspectorVectorRow">
                                    <TextBlock Text="Rotation XYZ"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding RotationX, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding RotationY, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding RotationZ, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,*,*"
                                      ColumnSpacing="6"
                                      Classes="InspectorVectorRow">
                                    <TextBlock Text="Scale"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding ScaleZ, UpdateSourceTrigger=PropertyChanged}"
                                             Classes="InspectorInput"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Components section heading + add menu. All optional
                             component cards (camera/renderable/render program/
                             subtree/collision/audio source/motion) and the simple
                             marker rows (audio listener, proximity, ...) are listed
                             beneath this heading. Transform/Visibility are core node
                             state, not components, so they stay above. -->
                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Components"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Add component">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Camera"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="camera"/>
                                                <MenuItem Header="Renderable"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="renderable"/>
                                                <MenuItem Header="Subtree from asset"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="subtree_from_asset"/>
                                                <MenuItem Header="Render program"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="render_program"/>
                                                <MenuItem Header="Proximity"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="proximity"/>
                                                <MenuItem Header="Collision"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="collision"/>
                                                <MenuItem Header="Motion"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="motion"/>
                                                <MenuItem Header="Motion Filter"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="motion_filter"/>
                                                <MenuItem Header="Audio Source"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="audio_source"/>
                                                <MenuItem Header="Audio Listener"
                                                          Command="{Binding AddComponentCommand}"
                                                          CommandParameter="audio_listener"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock Text="No attached optional components."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasNoComponents}"/>
                                <ItemsControl ItemsSource="{Binding Components}"
                                              IsVisible="{Binding HasComponents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorComponentViewModel">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="6">
                                                <TextBlock Text="{Binding Name}"
                                                           Classes="InspectorComponentName"/>
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="InspectorApplyButton"
                                                        ToolTip.Tip="Remove component"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasRenderableReference}">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Renderable Asset"
                                           Classes="InspectorSectionTitle"/>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Asset graph node"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding RenderableAssetGraphNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="0"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="6">
                                    <Button Content="Apply Renderable"
                                            Command="{Binding ApplyRenderableCommand}"
                                            Classes="InspectorApplyButton"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveRenderableCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove renderable"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Subtree from asset (issue #213): point this node at a
                             "Scene from GLB" asset-graph node so the runtime grafts that
                             GLB's hierarchy as the node's children. Attached via "Add
                             Component → Subtree from asset" (gated on HasSubtreeSection)
                             and removed via the header ✕, mirroring the Camera component.
                             Choosing a node in the combo applies immediately (no Apply
                             button); the ✕ clears the reference + removes the grafted
                             subtree from the tree + hides the section. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasSubtreeSection}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Subtree from asset"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveSubtreeComponentCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove subtree from asset"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Scene from GLB"
                                               Classes="InspectorPropertyName"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableSceneSources}"
                                              SelectedItem="{Binding SelectedSceneSourceOption, Mode=TwoWay}"
                                              PlaceholderText="Pick a Scene from GLB node"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding HasAvailableSceneSources}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="panes:InspectorSceneSourceOptionViewModel">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="No Scene from GLB nodes in the asset graph."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding !HasAvailableSceneSources}"/>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Referencing"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SubtreeReferenceDisplay}"
                                               TextWrapping="Wrap"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!-- Render program (issue #213): assign a render program to
                             this node. The program is inherited down the scene tree, so
                             setting it on a group host (e.g. a grafted GLB subtree's
                             root) cascades one program over the whole subtree and the
                             engine applies it to each part's geometry. Attached via
                             "Add Component → Render program" (gated on
                             HasRenderProgramSection), removed via the header ✕. Choosing
                             a node in the combo applies immediately (no Apply button),
                             mirroring the Camera/Subtree components. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasRenderProgramSection}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Render program"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveRenderProgramComponentCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove render program"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Program"
                                               Classes="InspectorPropertyName"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableRenderPrograms}"
                                              SelectedItem="{Binding SelectedRenderProgramOption, Mode=TwoWay}"
                                              PlaceholderText="Pick a render program node"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding HasAvailableRenderPrograms}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="panes:InspectorAssetGraphRefOptionViewModel">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text=""
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RenderProgramReferenceDisplay}"
                                               TextWrapping="Wrap"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <TextBlock Text="No render-program nodes in the asset graph."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding !HasAvailableRenderPrograms}"/>

                            </StackPanel>
                        </Border>

                        <!-- Renderable bindings + constants (issue #230): the
                             custom-renderable ingredient form, GENERATED from the
                             effective render program's authored binding layout
                             (#227). One source picker per declared SRV semantic
                             (options filtered to asset types publishing that
                             resource kind) and one typed value editor per declared
                             constant tail field. Picks + edits apply immediately
                             (house pattern); a row ✕ clears the pick / removes the
                             per-instance override. Constant edits are pack-time on
                             the engine — no recompile — so sliders/typing stream
                             live into the running viewport. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasRenderableIngredientsSection}">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Renderable bindings"
                                           Classes="InspectorSectionTitle"/>

                                <TextBlock Text="{Binding RenderableIngredientsHint}"
                                           TextWrapping="Wrap"
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasRenderableIngredientsHint}"/>

                                <ItemsControl ItemsSource="{Binding RenderableBindingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorRenderableBindingRowViewModel">
                                            <Grid ColumnDefinitions="*,*,Auto"
                                                  ColumnSpacing="10"
                                                  Classes="InspectorPropertyRow">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Semantic}"
                                                               Classes="InspectorPropertyName"/>
                                                    <TextBlock Text="{Binding KindLabel}"
                                                               Classes="InspectorPropertyValue"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                          PlaceholderText="Pick a source node"
                                                          HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding HasOptions}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="panes:InspectorAssetGraphRefOptionViewModel">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Command="{Binding ClearCommand}"
                                                        Classes="InspectorApplyButton"
                                                        ToolTip.Tip="Clear this binding"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Constants"
                                           Classes="InspectorSectionTitle"
                                           IsVisible="{Binding HasRenderableConstantRows}"/>

                                <ItemsControl ItemsSource="{Binding RenderableConstantRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorRenderableConstantRowViewModel">
                                            <Grid ColumnDefinitions="*,2*,Auto"
                                                  ColumnSpacing="10"
                                                  Classes="InspectorPropertyRow">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes="InspectorPropertyName"/>
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               Classes="InspectorPropertyValue"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1"
                                                      ColumnDefinitions="*,*,*,*"
                                                      ColumnSpacing="6">
                                                    <TextBox Text="{Binding ValueX, Mode=TwoWay}"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ValueY, Mode=TwoWay}"
                                                             IsVisible="{Binding ShowY}"/>
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding ValueZ, Mode=TwoWay}"
                                                             IsVisible="{Binding ShowZ}"/>
                                                    <TextBox Grid.Column="3"
                                                             Text="{Binding ValueW, Mode=TwoWay}"
                                                             IsVisible="{Binding ShowW}"/>
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="InspectorApplyButton"
                                                        IsEnabled="{Binding IsOverridden}"
                                                        ToolTip.Tip="Remove this override (falls back to the recipe default)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>

                        <!-- Collision (terrain-stick track): reference a Collision
                             asset-graph node ("Collision from height field" / mesh)
                             and toggle whether the node's movement is constrained by
                             it. Shown when the node has a Collision component
                             (HasCollisionComponent), removed via the header ✕.
                             Choosing a node / toggling the flag applies immediately
                             (no Apply button). The referenced node + flag are
                             session-local/optimistic for now. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasCollisionComponent}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Collision"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveCollisionComponentCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove collision"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Collision asset"
                                               Classes="InspectorPropertyName"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableCollisionSources}"
                                              SelectedItem="{Binding SelectedCollisionOption, Mode=TwoWay}"
                                              PlaceholderText="Pick a collision node"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding HasAvailableCollisionSources}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="panes:InspectorAssetGraphRefOptionViewModel">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text=""
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CollisionReferenceDisplay}"
                                               TextWrapping="Wrap"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <CheckBox Content="Constrain movement"
                                          IsChecked="{Binding CollisionConstrainMovement}"
                                          Classes="InspectorCheck"/>

                                <TextBlock Text="No collision nodes in the asset graph."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding !HasAvailableCollisionSources}"/>

                            </StackPanel>
                        </Border>

                        <!-- Audio Source (audio-track item 10): pick the audio-
                             renderable asset-graph node this node plays + its
                             per-entity play policy (auto-play / enabled). Shown when
                             the node has an AudioSource component, removed via the
                             header ✕. Choosing a node / toggling a flag applies
                             immediately (no Apply button). The picked reference
                             stores the stable asset-graph node id. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasAudioSourceComponent}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Audio Source"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveAudioSourceComponentCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove audio source"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Audio renderable"
                                               Classes="InspectorPropertyName"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableAudioRenderables}"
                                              SelectedItem="{Binding SelectedAudioRenderableOption, Mode=TwoWay}"
                                              PlaceholderText="Pick an audio renderable node"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding HasAvailableAudioRenderables}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="panes:InspectorAssetGraphRefOptionViewModel">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text=""
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AudioRenderableReferenceDisplay}"
                                               TextWrapping="Wrap"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <CheckBox Content="Auto-play on load"
                                          IsChecked="{Binding AudioSourceAutoPlay}"
                                          Classes="InspectorCheck"/>
                                <CheckBox Content="Enabled"
                                          IsChecked="{Binding AudioSourceEnabled}"
                                          Classes="InspectorCheck"/>

                                <TextBlock Text="No audio renderable nodes in the asset graph."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding !HasAvailableAudioRenderables}"/>

                            </StackPanel>
                        </Border>

                        <!-- Motion (terrain-stick track): the Motion component's
                             terrain-constraint fields — whether the node sticks to the
                             terrain, ride height, footprint radius, surface-alignment
                             toggle, and alignment strength. Shown when the node has a
                             Motion component (HasMotionComponent), removed via the
                             header ✕. Every change applies live (no Apply button).
                             Field values are session-local/optimistic for now. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasMotionComponent}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Motion"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveMotionComponentCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove motion"/>
                                </Grid>

                                <CheckBox Content="Terrain constrained"
                                          IsChecked="{Binding MotionTerrainConstrained}"
                                          Classes="InspectorCheck"/>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Ride height"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionRideHeight}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Footprint radius"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFootprintRadius}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <CheckBox Content="Align to surface"
                                          IsChecked="{Binding MotionAlignToSurface}"
                                          Classes="InspectorCheck"/>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Alignment strength"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionAlignmentStrength}"
                                             Classes="InspectorInput"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!-- Motion Filter (secondary-motion camera damping): per-DOF
                             smoothing + clamp of the node's driven transform. Translation
                             channels are WORLD axes (0 smoothing = pass through, e.g. keep
                             the bob); rotation channels roll/pitch/yaw are node-LOCAL. Shown
                             when the node has the component; every change applies live. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasMotionFilterComponent}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Motion Filter"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveMotionFilterComponentCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove motion filter"/>
                                </Grid>

                                <CheckBox Content="Enabled"
                                          IsChecked="{Binding MotionFilterEnabled}"
                                          Classes="InspectorCheck"/>

                                <TextBlock Text="Translation smoothing (s, world axes; 0 = off)"
                                           Classes="InspectorPropertyName"/>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="X" Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterTranslationSmoothingX}"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Y" Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterTranslationSmoothingY}"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Z" Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterTranslationSmoothingZ}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <CheckBox Content="Terrain floor (clamp world Y above terrain)"
                                          IsChecked="{Binding MotionFilterTerrainFloor}"
                                          Classes="InspectorCheck"/>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Floor offset"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterTerrainFloorOffset}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <TextBlock Text="Roll (about forward)"
                                           Classes="InspectorSectionTitle"/>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Smoothing (s)"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterRollSmoothing}"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <CheckBox Content="Level (ease to horizon)"
                                          IsChecked="{Binding MotionFilterRollLevel}"
                                          Classes="InspectorCheck"/>
                                <CheckBox Content="Limit angle"
                                          IsChecked="{Binding MotionFilterRollLimit}"
                                          Classes="InspectorCheck"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Min°" Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterRollLimitMin}"
                                             Classes="InspectorInput"/>
                                    <TextBlock Grid.Column="2" Text="Max°"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding MotionFilterRollLimitMax}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <TextBlock Text="Pitch (about right)"
                                           Classes="InspectorSectionTitle"/>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Smoothing (s)"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterPitchSmoothing}"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <CheckBox Content="Level (ease to horizon)"
                                          IsChecked="{Binding MotionFilterPitchLevel}"
                                          Classes="InspectorCheck"/>
                                <CheckBox Content="Limit angle"
                                          IsChecked="{Binding MotionFilterPitchLimit}"
                                          Classes="InspectorCheck"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Min°" Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterPitchLimitMin}"
                                             Classes="InspectorInput"/>
                                    <TextBlock Grid.Column="2" Text="Max°"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding MotionFilterPitchLimitMax}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <TextBlock Text="Yaw (about up)"
                                           Classes="InspectorSectionTitle"/>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Smoothing (s)"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterYawSmoothing}"
                                             Classes="InspectorInput"/>
                                </Grid>
                                <CheckBox Content="Level"
                                          IsChecked="{Binding MotionFilterYawLevel}"
                                          Classes="InspectorCheck"/>
                                <CheckBox Content="Limit angle"
                                          IsChecked="{Binding MotionFilterYawLimit}"
                                          Classes="InspectorCheck"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Min°" Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MotionFilterYawLimitMin}"
                                             Classes="InspectorInput"/>
                                    <TextBlock Grid.Column="2" Text="Max°"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding MotionFilterYawLimitMax}"
                                             Classes="InspectorInput"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasCameraComponent}">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Camera"
                                               Classes="InspectorSectionTitle"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding RemoveCameraCommand}"
                                            Classes="InspectorApplyButton"
                                            ToolTip.Tip="Remove camera"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="FOV Y"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CameraFovY}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Near"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CameraNear}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Far"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CameraFar}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Aspect"
                                               Classes="InspectorPropertyName"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CameraAspect}"
                                             Classes="InspectorInput"/>
                                </Grid>

                                <Button Content="Apply Camera"
                                        Command="{Binding ApplyCameraCommand}"
                                        Classes="InspectorApplyButton"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Behaviors"
                                               Classes="InspectorSectionTitle"/>
                                    <!-- The menu is built + shown from code-behind (OnAddBehaviorClick)
                                         as plain MenuItems, so they use the same default MenuItem theme as
                                         the Components dropdown above, and the items exist BEFORE the popup
                                         is shown (populating a Button.Flyout MenuFlyout during Opening is
                                         too late — its presenter is already built, so it renders empty). -->
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Classes="InspectorApplyButton"
                                            Click="OnAddBehaviorClick"
                                            ToolTip.Tip="Add behavior from imported modules"/>
                                </Grid>
                                <TextBlock Text="No behavior bindings."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasNoBehaviors}"/>
                                <ItemsControl ItemsSource="{Binding Behaviors}"
                                              IsVisible="{Binding HasBehaviors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorBehaviorViewModel">
                                            <StackPanel Classes="InspectorPropertyRow" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="6">
                                                    <CheckBox Content="enabled"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Classes="InspectorCheck"/>
                                                    <Button Grid.Column="1"
                                                            Content="Remove"
                                                            Command="{Binding RemoveCommand}"
                                                            Classes="InspectorApplyButton"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="Module"
                                                               Classes="InspectorPropertyName"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Module, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Classes="InspectorInput"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="Label"
                                                               Classes="InspectorPropertyName"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Classes="InspectorInput"/>
                                                </Grid>
                                                <Button Content="Apply Module/Label"
                                                        Command="{Binding ApplyFieldsCommand}"
                                                        Classes="InspectorApplyButton"/>
                                                <TextBlock Text="Events (one channel per line)"
                                                           Classes="InspectorPropertyName"/>
                                                <TextBox Text="{Binding Events, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         Classes="InspectorInput"/>
                                                <Button Content="Apply Events"
                                                        Command="{Binding ApplyEventsCommand}"
                                                        Classes="InspectorApplyButton"/>
                                                <TextBlock Text="Config"
                                                           Classes="InspectorPropertyName"
                                                           IsVisible="{Binding HasConfig}"/>
                                                <ItemsControl ItemsSource="{Binding Config}"
                                                              IsVisible="{Binding HasConfig}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="panes:InspectorBehaviorConfigViewModel">
                                                            <Grid ColumnDefinitions="Auto,*"
                                                                  ColumnSpacing="10">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Classes="InspectorPropertyName"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Detail}"
                                                                           Classes="InspectorPortDetail"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="6">
                                    <TextBox Text="{Binding NewBehaviorModule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="behavior module name"
                                             Classes="InspectorInput"/>
                                    <Button Grid.Column="1"
                                            Content="Add Behavior"
                                            Command="{Binding AddBehaviorCommand}"
                                            Classes="InspectorApplyButton"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasAssetGraphNodeSelection}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Header}"
                                   Classes="InspectorHeader"/>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Asset Graph Node"
                                           Classes="InspectorSectionTitle"/>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Node"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodeId}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Name"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodeName}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Type"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodeType}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Type ID"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodeTypeId}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Schema"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodeSchema}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Compile"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodeCompileStatus}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Classes="InspectorPropertyRow">
                                    <TextBlock Text="Position"
                                               Classes="InspectorPropertyName"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AssetGraphNodePosition}"
                                               Classes="InspectorPropertyValue"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Named reroute"
                                           Classes="InspectorSectionTitle"/>
                                <TextBox Text="{Binding NodeRerouteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="name to collapse this output's wires"
                                         Classes="InspectorInput"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Parameters"
                                           Classes="InspectorSectionTitle"/>
                                <TextBlock Text="No parameters."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasNoAssetGraphParams}"/>
                                <ItemsControl ItemsSource="{Binding AssetGraphParams}"
                                              IsVisible="{Binding HasAssetGraphParams}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorAssetGraphParamViewModel">
                                            <StackPanel Classes="InspectorPropertyRow">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes="InspectorPropertyName"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Detail}"
                                                               Classes="InspectorPortDetail"/>
                                                </Grid>
                                                <!-- Commit on edit-finished (LostFocus), not per keystroke and
                                                     not via a separate Apply button (#218 Phase 3): the view
                                                     model applies the value once the field loses focus. -->
                                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Classes="InspectorInput"
                                                         IsVisible="{Binding IsTextEditable}"/>
                                                <CheckBox Content="enabled"
                                                          IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                          Classes="InspectorCheck"
                                                          IsVisible="{Binding IsBool}"/>
                                                <ComboBox ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding Value, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          Classes="InspectorInput"
                                                          IsVisible="{Binding IsEnum}"/>
                                                <TextBlock Text="{Binding Value}"
                                                           Classes="InspectorPropertyValue"
                                                           IsVisible="{Binding IsReadOnlyText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- GLB node tree picker (issue #213): only for the "Mesh from
                             GLB scene" node. Shows the connected GLB scene's hierarchy
                             as an expandable tree; clicking a mesh-bearing node sets the
                             node's node_id param (the generic text param above stays as
                             the typed fallback). Group (mesh-less) nodes show for
                             structure but are not pickable. A hint shows when the GLB
                             could not be resolved/read. -->
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding HasGlbNodePicker}">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="GLB node"
                                           Classes="InspectorSectionTitle"/>
                                <TextBlock Text="Pick the GLB node whose mesh this node extracts."
                                           Classes="InspectorPropertyName"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GlbNodePickerHint}"
                                           Classes="PaneEmptyState"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasGlbNodePickerHint}"/>
                                <TreeView ItemsSource="{Binding GlbNodes}"
                                          IsVisible="{Binding HasGlbNodes}"
                                          Classes="GlbNodeTree">
                                    <TreeView.DataTemplates>
                                        <TreeDataTemplate DataType="panes:InspectorGlbComponentNodeViewModel"
                                                          ItemsSource="{Binding Children}">
                                            <Button Classes="GlbNodePick"
                                                    Classes.current="{Binding IsCurrentPick}"
                                                    Command="{Binding PickCommand}"
                                                    IsEnabled="{Binding IsSelectable}"
                                                    ToolTip.Tip="{Binding Id}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="◆ mesh"
                                                               Classes="GlbNodeMeshMarker"
                                                               IsVisible="{Binding HasMesh}"/>
                                                    <TextBlock Text="▷ group"
                                                               Classes="GlbNodeGroupMarker"
                                                               IsVisible="{Binding IsGroup}"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </TreeDataTemplate>
                                    </TreeView.DataTemplates>
                                </TreeView>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Diagnostics"
                                           Classes="InspectorSectionTitle"/>
                                <TextBlock Text="No diagnostics."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasNoAssetGraphDiagnostics}"/>
                                <ItemsControl ItemsSource="{Binding AssetGraphDiagnostics}"
                                              IsVisible="{Binding HasAssetGraphDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorAssetGraphDiagnosticViewModel">
                                            <StackPanel Classes="InspectorDiagnosticItem">
                                                <TextBlock Text="{Binding Message}"
                                                           Classes="InspectorDiagnosticMessage"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Classes="InspectorDiagnosticMeta"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Input Ports"
                                           Classes="InspectorSectionTitle"/>
                                <TextBlock Text="No input ports."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasNoAssetGraphInputPorts}"/>
                                <ItemsControl ItemsSource="{Binding AssetGraphInputPorts}"
                                              IsVisible="{Binding HasAssetGraphInputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorAssetGraphPortViewModel">
                                            <StackPanel Classes="InspectorPortItem">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Classes="InspectorComponentName"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Classes="InspectorPortDetail"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Output Ports"
                                           Classes="InspectorSectionTitle"/>
                                <TextBlock Text="No output ports."
                                           Classes="PaneEmptyState"
                                           IsVisible="{Binding HasNoAssetGraphOutputPorts}"/>
                                <ItemsControl ItemsSource="{Binding AssetGraphOutputPorts}"
                                              IsVisible="{Binding HasAssetGraphOutputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="panes:InspectorAssetGraphPortViewModel">
                                            <StackPanel Classes="InspectorPortItem">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Classes="InspectorComponentName"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Classes="InspectorPortDetail"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasStatechartNodeSelection}"
                              x:CompileBindings="False">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Header}" Classes="InspectorHeader"/>
                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="{Binding SelectedStatechartNode.Subtitle}"
                                           Classes="InspectorSectionTitle"/>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartNode.PropertyRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" Classes="InspectorPropertyName"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding SelectedStatechartNode.HasSpecFields}">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Agent spec" Classes="InspectorSectionTitle"/>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartNode.SpecFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" Classes="InspectorPropertyName"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="InspectorInput"
                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="InspectorSectionCard"
                                IsVisible="{Binding SelectedStatechartNode.HasInputPorts}">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="Inputs" Classes="InspectorSectionTitle"/>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartNode.InputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" Classes="InspectorPropertyName"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="InspectorInput"
                                                         Text="{Binding ConstEditor.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         IsVisible="{Binding IsConstant}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                            IsVisible="{Binding IsWired}">
                                                    <TextBlock Text="{Binding InspectorValue}" VerticalAlignment="Center"/>
                                                    <Button Content="Disconnect"
                                                            Classes="InspectorApplyButton"
                                                            Command="{Binding DisconnectCommand}"
                                                            IsVisible="{Binding CanDisconnect}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasStatechartStateSelection}"
                              x:CompileBindings="False">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Header}" Classes="InspectorHeader"/>
                        <Border Classes="InspectorSectionCard">
                            <StackPanel Classes="InspectorSection">
                                <TextBlock Text="State" Classes="InspectorSectionTitle"/>
                                <TextBlock Text="&#x25B6; initial state"
                                           IsVisible="{Binding SelectedStatechartState.IsInitial}"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBlock Text="do" Classes="InspectorSectionTitle" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ &#x25BE;" Classes="InspectorApplyButton">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="set_goal" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetGoal}"/>
                                                <MenuItem Header="set_decoherence" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetDecoherence}"/>
                                                <MenuItem Header="rearm" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.Rearm}"/>
                                                <MenuItem Header="reward" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.Reward}"/>
                                                <Separator/>
                                                <MenuItem Header="set_scale" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetScale}"/>
                                                <MenuItem Header="set_visible" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetVisible}"/>
                                                <MenuItem Header="play_sound" Command="{Binding SelectedStatechartState.AddDoEffectCommand}" CommandParameter="{x:Static model:EffectKind.PlaySound}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartState.DoEffectRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" Classes="InspectorPropertyName"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="InspectorInput"
                                                         Text="{Binding ValueEditor.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         IsVisible="{Binding IsEditable}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ReadOnlyValue}"
                                                           IsVisible="{Binding HasReadOnlyValue}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="&#x2715;" Classes="InspectorApplyButton"
                                                        VerticalAlignment="Center" Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBlock Text="entry" Classes="InspectorSectionTitle" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ &#x25BE;" Classes="InspectorApplyButton">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="set_goal" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetGoal}"/>
                                                <MenuItem Header="set_decoherence" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetDecoherence}"/>
                                                <MenuItem Header="rearm" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.Rearm}"/>
                                                <MenuItem Header="reward" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.Reward}"/>
                                                <Separator/>
                                                <MenuItem Header="set_scale" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetScale}"/>
                                                <MenuItem Header="set_visible" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetVisible}"/>
                                                <MenuItem Header="play_sound" Command="{Binding SelectedStatechartState.AddEntryEffectCommand}" CommandParameter="{x:Static model:EffectKind.PlaySound}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartState.EntryEffectRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" Classes="InspectorPropertyName"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="InspectorInput"
                                                         Text="{Binding ValueEditor.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         IsVisible="{Binding IsEditable}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ReadOnlyValue}"
                                                           IsVisible="{Binding HasReadOnlyValue}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="&#x2715;" Classes="InspectorApplyButton"
                                                        VerticalAlignment="Center" Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBlock Text="exit" Classes="InspectorSectionTitle" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ &#x25BE;" Classes="InspectorApplyButton">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="set_goal" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetGoal}"/>
                                                <MenuItem Header="set_decoherence" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetDecoherence}"/>
                                                <MenuItem Header="rearm" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.Rearm}"/>
                                                <MenuItem Header="reward" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.Reward}"/>
                                                <Separator/>
                                                <MenuItem Header="set_scale" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetScale}"/>
                                                <MenuItem Header="set_visible" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.SetVisible}"/>
                                                <MenuItem Header="play_sound" Command="{Binding SelectedStatechartState.AddExitEffectCommand}" CommandParameter="{x:Static model:EffectKind.PlaySound}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartState.ExitEffectRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" Classes="InspectorPropertyName"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBox Grid.Column="1"
                                                         Classes="InspectorInput"
                                                         Text="{Binding ValueEditor.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         IsVisible="{Binding IsEditable}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ReadOnlyValue}"
                                                           IsVisible="{Binding HasReadOnlyValue}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="&#x2715;" Classes="InspectorApplyButton"
                                                        VerticalAlignment="Center" Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="transitions" Classes="InspectorSectionTitle" Margin="0,8,0,0"
                                           IsVisible="{Binding SelectedStatechartState.HasTransitions}"/>
                                <ItemsControl ItemsSource="{Binding SelectedStatechartState.TransitionRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" Classes="InspectorPropertyName"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <ComboBox Classes="InspectorInput"
                                                              MinWidth="96"
                                                              ItemsSource="{Binding TriggerKinds}"
                                                              SelectedItem="{Binding SelectedTriggerKind, Mode=TwoWay}"/>
                                                    <TextBox Width="70" IsVisible="{Binding IsAfter}"
                                                             Classes="InspectorInput"
                                                             Text="{Binding SecondsEditor.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Text="s" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsAfter}"/>
                                                    <TextBlock Text="{Binding ActionSummary}" Classes="InspectorPropertyName"
                                                               VerticalAlignment="Center" IsVisible="{Binding HasActions}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Delete"
                                                        Classes="InspectorApplyButton"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
