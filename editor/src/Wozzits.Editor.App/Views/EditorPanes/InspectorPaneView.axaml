<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Wozzits.Editor.ViewModels.EditorPanes"
             x:Class="Wozzits.Editor.App.Views.EditorPanes.InspectorPaneView"
             x:DataType="panes:InspectorPaneViewModel">
    <Grid Classes="EditorPaneRoot">
        <Border Classes="PaneSurface">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock Text="{Binding EmptyState}"
                           Classes="PaneEmptyState"
                           IsVisible="{Binding HasNoSelection}"/>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasSceneNodeSelection}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Header}"
                                   Classes="InspectorHeader"/>
                        <TextBlock Text="{Binding LastEditError}"
                                   Classes="InspectorError"
                                   IsVisible="{Binding HasLastEditError}"/>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Scene Node"
                                       Classes="InspectorSectionTitle"/>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Node"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NodeId}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Name"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NodeName}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Parent"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ParentId}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <CheckBox Content="Node visible"
                                      IsChecked="{Binding NodeVisible}"
                                      Classes="InspectorCheck"/>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Renderable source"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RenderableSource}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Button Content="Apply Node"
                                    Command="{Binding ApplyNodePropertiesCommand}"
                                    Classes="InspectorApplyButton"/>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection"
                                    IsVisible="{Binding HasTransform}">
                            <TextBlock Text="Transform"
                                       Classes="InspectorSectionTitle"/>

                            <Grid ColumnDefinitions="Auto,*,*,*"
                                  ColumnSpacing="6"
                                  Classes="InspectorVectorRow">
                                <TextBlock Text="Translation"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TranslationX}"
                                         Classes="InspectorInput"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding TranslationY}"
                                         Classes="InspectorInput"/>
                                <TextBox Grid.Column="3"
                                         Text="{Binding TranslationZ}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,*,*"
                                  ColumnSpacing="6"
                                  Classes="InspectorVectorRow">
                                <TextBlock Text="Rotation XYZ"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RotationX}"
                                         Classes="InspectorInput"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding RotationY}"
                                         Classes="InspectorInput"/>
                                <TextBox Grid.Column="3"
                                         Text="{Binding RotationZ}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,*,*"
                                  ColumnSpacing="6"
                                  Classes="InspectorVectorRow">
                                <TextBlock Text="Scale"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ScaleX}"
                                         Classes="InspectorInput"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ScaleY}"
                                         Classes="InspectorInput"/>
                                <TextBox Grid.Column="3"
                                         Text="{Binding ScaleZ}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Button Content="Apply Transform"
                                    Command="{Binding ApplyTransformCommand}"
                                    Classes="InspectorApplyButton"/>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Renderable Asset"
                                       Classes="InspectorSectionTitle"/>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Asset graph node"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RenderableAssetGraphNodeId}"
                                         PlaceholderText="0"
                                         Classes="InspectorInput"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="{Binding ComponentsHeader}"
                                       Classes="InspectorSectionTitle"/>
                            <TextBlock Text="No attached optional components."
                                       Classes="PaneEmptyState"
                                       IsVisible="{Binding HasNoComponents}"/>
                            <ItemsControl ItemsSource="{Binding Components}"
                                          IsVisible="{Binding HasComponents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="panes:InspectorComponentViewModel">
                                        <TextBlock Text="{Binding Name}"
                                                   Classes="InspectorComponentName"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection"
                                    IsVisible="{Binding HasCameraComponent}">
                            <TextBlock Text="Camera"
                                       Classes="InspectorSectionTitle"/>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="FOV Y"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CameraFovY}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Near"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CameraNear}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Far"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CameraFar}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Aspect"
                                           Classes="InspectorPropertyName"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CameraAspect}"
                                         Classes="InspectorInput"/>
                            </Grid>

                            <Button Content="Apply Camera"
                                    Command="{Binding ApplyCameraCommand}"
                                    Classes="InspectorApplyButton"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasAssetGraphNodeSelection}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Header}"
                                   Classes="InspectorHeader"/>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Asset Graph Node"
                                       Classes="InspectorSectionTitle"/>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Node"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodeId}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Name"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodeName}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Type"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodeType}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Type ID"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodeTypeId}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Schema"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodeSchema}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Compile"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodeCompileStatus}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  Classes="InspectorPropertyRow">
                                <TextBlock Text="Position"
                                           Classes="InspectorPropertyName"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssetGraphNodePosition}"
                                           Classes="InspectorPropertyValue"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Parameters"
                                       Classes="InspectorSectionTitle"/>
                            <TextBlock Text="No parameters."
                                       Classes="PaneEmptyState"
                                       IsVisible="{Binding HasNoAssetGraphParams}"/>
                            <ItemsControl ItemsSource="{Binding AssetGraphParams}"
                                          IsVisible="{Binding HasAssetGraphParams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="panes:InspectorAssetGraphParamViewModel">
                                        <StackPanel Classes="InspectorPropertyRow">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="10">
                                                <TextBlock Text="{Binding Name}"
                                                           Classes="InspectorPropertyName"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Detail}"
                                                           Classes="InspectorPortDetail"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="6"
                                                  IsVisible="{Binding IsTextEditable}">
                                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Classes="InspectorInput"/>
                                                <Button Grid.Column="1"
                                                        Content="Apply"
                                                        Command="{Binding ApplyCommand}"
                                                        Classes="InspectorApplyButton"/>
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding Value}"
                                                      IsEnabled="False"
                                                      HorizontalAlignment="Stretch"
                                                      Classes="InspectorInput"
                                                      IsVisible="{Binding IsEnum}"/>
                                            <TextBlock Text="{Binding Value}"
                                                       Classes="InspectorPropertyValue"
                                                       IsVisible="{Binding IsReadOnlyText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Diagnostics"
                                       Classes="InspectorSectionTitle"/>
                            <TextBlock Text="No diagnostics."
                                       Classes="PaneEmptyState"
                                       IsVisible="{Binding HasNoAssetGraphDiagnostics}"/>
                            <ItemsControl ItemsSource="{Binding AssetGraphDiagnostics}"
                                          IsVisible="{Binding HasAssetGraphDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="panes:InspectorAssetGraphDiagnosticViewModel">
                                        <StackPanel Classes="InspectorDiagnosticItem">
                                            <TextBlock Text="{Binding Message}"
                                                       Classes="InspectorDiagnosticMessage"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Classes="InspectorDiagnosticMeta"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Input Ports"
                                       Classes="InspectorSectionTitle"/>
                            <TextBlock Text="No input ports."
                                       Classes="PaneEmptyState"
                                       IsVisible="{Binding HasNoAssetGraphInputPorts}"/>
                            <ItemsControl ItemsSource="{Binding AssetGraphInputPorts}"
                                          IsVisible="{Binding HasAssetGraphInputPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="panes:InspectorAssetGraphPortViewModel">
                                        <StackPanel Classes="InspectorPortItem">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Classes="InspectorComponentName"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Classes="InspectorPortDetail"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Classes="InspectorSection">
                            <TextBlock Text="Output Ports"
                                       Classes="InspectorSectionTitle"/>
                            <TextBlock Text="No output ports."
                                       Classes="PaneEmptyState"
                                       IsVisible="{Binding HasNoAssetGraphOutputPorts}"/>
                            <ItemsControl ItemsSource="{Binding AssetGraphOutputPorts}"
                                          IsVisible="{Binding HasAssetGraphOutputPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="panes:InspectorAssetGraphPortViewModel">
                                        <StackPanel Classes="InspectorPortItem">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Classes="InspectorComponentName"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Classes="InspectorPortDetail"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
