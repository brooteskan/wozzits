        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Wozzits.Editor.App.Views.ProjectDirectoryPickerWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Wozzits Editor"
        Width="1"
        Height="1"
