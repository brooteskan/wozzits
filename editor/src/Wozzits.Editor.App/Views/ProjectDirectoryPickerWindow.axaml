<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Wozzits.Editor.App.Views.ProjectDirectoryPickerWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Choose Wozzits Project"
        Width="420"
        Height="150"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="18" Spacing="8">
        <TextBlock Text="Choose Wozzits Project" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Select the directory the editor should work in." Opacity="0.75"/>
        <TextBlock Text="Canceling the browser closes Wozzits Editor." Opacity="0.75"/>
    </StackPanel>
</Window>
