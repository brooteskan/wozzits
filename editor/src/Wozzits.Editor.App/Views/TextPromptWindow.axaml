<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="400" d:DesignHeight="150"
        x:Class="Wozzits.Editor.App.Views.TextPromptWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Name"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="18" RowSpacing="12">
        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap"/>
        <TextBox x:Name="Input" Grid.Row="1" Classes="InspectorInput"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" Click="OnOk" IsDefault="True" MinWidth="72"/>
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
