<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Daylight theme: the original Solarized-dark cyan palette. The editor's
         styles bind these keys via DynamicResource, so swapping this dictionary
         for another (see EditorTheme) re-themes the whole UI live. -->
    <Color x:Key="WozzitsShellBackgroundColor">#002B36</Color>
    <Color x:Key="WozzitsPanelBackgroundColor">#073642</Color>
    <Color x:Key="WozzitsPanelInsetColor">#0B4655</Color>
    <Color x:Key="WozzitsPanelBorderColor">#174C57</Color>
    <Color x:Key="WozzitsTextColor">#EEE8D5</Color>
    <Color x:Key="WozzitsMutedTextColor">#93A1A1</Color>
    <Color x:Key="WozzitsAccentColor">#2AA198</Color>
    <Color x:Key="WozzitsSuccessColor">#009900</Color>
    <Color x:Key="WozzitsWarningColor">#EE8900</Color>
    <Color x:Key="WozzitsGraphWireColor">#268BD2</Color>
    <Color x:Key="WozzitsErrorColor">#EE322F</Color>

    <SolidColorBrush x:Key="WozzitsShellBackgroundBrush"
                     Color="{StaticResource WozzitsShellBackgroundColor}"/>
    <SolidColorBrush x:Key="WozzitsPanelBackgroundBrush"
                     Color="{StaticResource WozzitsPanelBackgroundColor}"/>
    <SolidColorBrush x:Key="WozzitsPanelInsetBrush"
                     Color="{StaticResource WozzitsPanelInsetColor}"/>
    <SolidColorBrush x:Key="WozzitsPanelBorderBrush"
                     Color="{StaticResource WozzitsPanelBorderColor}"/>
    <SolidColorBrush x:Key="WozzitsTextBrush"
                     Color="{StaticResource WozzitsTextColor}"/>
    <SolidColorBrush x:Key="WozzitsMutedTextBrush"
                     Color="{StaticResource WozzitsMutedTextColor}"/>
    <SolidColorBrush x:Key="WozzitsAccentBrush"
                     Color="{StaticResource WozzitsAccentColor}"/>
    <SolidColorBrush x:Key="WozzitsSuccessBrush"
                     Color="{StaticResource WozzitsSuccessColor}"/>
    <SolidColorBrush x:Key="WozzitsWarningBrush"
                     Color="{StaticResource WozzitsWarningColor}"/>
    <SolidColorBrush x:Key="WozzitsGraphWireBrush"
                     Color="{StaticResource WozzitsGraphWireColor}"/>
    <SolidColorBrush x:Key="WozzitsErrorBrush"
                     Color="{StaticResource WozzitsErrorColor}"/>

    <!-- Translucent accent fill for the asset-graph rubber-band selection. -->
    <SolidColorBrush x:Key="WozzitsSelectionOverlayBrush" Color="#332AA198"/>

    <!-- Compile-status dots: deliberately bright/saturated (a departure from the
         muted theme) so ready/changed/error read apart at a glance. -->
    <SolidColorBrush x:Key="WozzitsDotReadyBrush" Color="#22DD3C"/>
    <SolidColorBrush x:Key="WozzitsDotChangedBrush" Color="#FFD60A"/>
    <SolidColorBrush x:Key="WozzitsDotErrorBrush" Color="#FF3B30"/>
</ResourceDictionary>
