<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test-owned GLB + project fixtures (copied, frozen), so the native GLB
       integration tests never depend on the engine's shared resources/. -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wozzits.Editor.Core\Wozzits.Editor.Core.csproj" />
    <ProjectReference Include="..\..\src\Wozzits.Editor.Protocol\Wozzits.Editor.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Wozzits.Editor.HostClient\Wozzits.Editor.HostClient.csproj" />
    <ProjectReference Include="..\..\src\Wozzits.Editor.ViewModels\Wozzits.Editor.ViewModels.csproj" />
  </ItemGroup>

</Project>