{
  "schema": "wozzits.statechart.ir.v0",
  "name": "skinner",
  "bindings": [
    { "port": "lamp_0", "find": "lamp_0", "scope": "subtree" },
    { "port": "lamp_1", "find": "lamp_1", "scope": "subtree" }
  ],
  "agents": [
    { "id": "sig", "owned": true, "host": "self",
      "spec": { "decisions": 1, "goal": 0, "memory": 1, "gamma_start": 2,
                "anneal_seconds": 2, "confidence": 0.9, "decoherence": 0.4,
                "think_interval": 0.15 } }
  ],
  "pure": [
    { "id": "z",   "op": "marginal",  "agent": "sig", "slot": 0 },
    { "id": "c",   "op": "committed", "agent": "sig", "slot": 0 },
    { "id": "m",   "op": "memory",    "agent": "sig", "q": 0 },
    { "id": "g",   "op": "mul", "ins": [ {"op":"m"}, {"const": 0.8} ] },
    { "id": "md0", "op": "mul_add", "ins": [ {"op":"z"}, {"const": 0.5}, {"const": 0.5} ] },
    { "id": "md1", "op": "mul_add", "ins": [ {"op":"z"}, {"const": -0.5}, {"const": 0.5} ] },
    { "id": "p0",  "op": "clamp01", "ins": [ {"op":"md0"} ] },
    { "id": "p1",  "op": "clamp01", "ins": [ {"op":"md1"} ] },
    { "id": "s0d", "op": "mul", "ins": [ {"op":"p0"}, {"const": 3} ] },
    { "id": "s1d", "op": "mul", "ins": [ {"op":"p1"}, {"const": 3} ] },
    { "id": "is0", "op": "eq", "ins": [ {"op":"c"}, {"const": 0} ] },
    { "id": "is1", "op": "eq", "ins": [ {"op":"c"}, {"const": 1} ] },
    { "id": "s0h", "op": "select", "cond": {"op":"is0"}, "a": {"const": 3}, "b": {"const": 0} },
    { "id": "s1h", "op": "select", "cond": {"op":"is1"}, "a": {"const": 3}, "b": {"const": 0} }
  ],
  "regions": [
    { "id": "learn", "initial": "DELIBERATE", "states": ["DELIBERATE", "HOLD"] }
  ],
  "states": [
    { "id": "DELIBERATE",
      "do": [
        { "kind": "set_scale",   "target": {"bind":"lamp_0"}, "value": {"op":"s0d"} },
        { "kind": "set_scale",   "target": {"bind":"lamp_1"}, "value": {"op":"s1d"} },
        { "kind": "set_visible", "target": {"bind":"lamp_0"}, "value": {"const": true} },
        { "kind": "set_visible", "target": {"bind":"lamp_1"}, "value": {"const": true} },
        { "kind": "set_goal", "agent": "sig", "slot": 0, "value": {"op":"g"} }
      ],
      "transitions": [
        { "trigger": {"kind":"commit","agent":"sig","slot":0,"outcome":0},
          "actions": [ {"kind":"reward","agent":"sig","q":0,"branch":false,"strength":{"const":0.5}} ],
          "target": "HOLD" },
        { "trigger": {"kind":"commit","agent":"sig","slot":0,"outcome":1},
          "actions": [ {"kind":"reward","agent":"sig","q":0,"branch":true,"strength":{"const":-0.3}} ],
          "target": "HOLD" }
      ]
    },
    { "id": "HOLD",
      "do": [
        { "kind": "set_scale",   "target": {"bind":"lamp_0"}, "value": {"op":"s0h"} },
        { "kind": "set_scale",   "target": {"bind":"lamp_1"}, "value": {"op":"s1h"} },
        { "kind": "set_visible", "target": {"bind":"lamp_0"}, "value": {"op":"is0"} },
        { "kind": "set_visible", "target": {"bind":"lamp_1"}, "value": {"op":"is1"} },
        { "kind": "set_goal", "agent": "sig", "slot": 0, "value": {"op":"g"} }
      ],
      "transitions": [
        { "trigger": {"kind":"after","seconds":6}, "actions": [ {"kind":"rearm","agent":"sig"} ], "target": "DELIBERATE" }
      ]
    }
  ]
}
